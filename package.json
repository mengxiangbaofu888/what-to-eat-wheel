{
  "name": "what-to-eat-wheel",
  "version": "1.0.5",
  "private": true,
  "type": "module",
  "description": "吃啥转盘 · 自定义菜名 + 拍照识别食堂菜品 + 大类/小项多选 + 转盘随机决定今天吃啥",
  "keywords": [
    "转盘",
    "今天吃啥",
    "吃什么",
    "抽签",
    "决策",
    "Capacitor",
    "离线"
  ],
  "license": "MIT",
  "author": "mengxiangbaofu",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node scripts/test-classify.mjs && node scripts/smoke-test.mjs",
    "test:classify": "node scripts/test-classify.mjs",
    "test:smoke": "node scripts/build.mjs && node scripts/smoke-test.mjs",
    "serve": "node scripts/build.mjs && node scripts/serve.mjs",
    "apk": "node scripts/build-apk.mjs",
    "apk:release": "node scripts/build-apk.mjs release",
    "setup:android": "node scripts/setup-android.mjs",
    "publish:github": "node scripts/publish-github.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "render:wheel": "node scripts/render-wheel.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@napi-rs/canvas": "^1.0.10",
    "jsdom": "^30.1.2"
  }
}
